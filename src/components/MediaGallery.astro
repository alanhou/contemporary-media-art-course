---
import type { Lang, MediaItem } from "@/data/course";

type Props = {
  items: MediaItem[];
  lang: Lang;
};

const { items, lang } = Astro.props;
---

{items.length > 0 && (
  <div class="media-gallery">
    {items.map((item) => (
      <article class="media-card">
        {item.imageUrl && (
          <a class="media-image" href={item.sourceUrl} target="_blank" rel="noreferrer">
            <img src={item.imageUrl} alt={`${item.title} — ${item.creator}`} loading="lazy" />
          </a>
        )}
        <div class="media-copy">
          <p class="eyebrow">{item.year}</p>
          <h3>{item.title}</h3>
          <p class="media-creator">{item.creator}</p>
          <p>{item.caption[lang]}</p>
          <a class="source-link" href={item.sourceUrl} target="_blank" rel="noreferrer">
            {lang === "en" ? "Source / license" : "来源 / 授权"}
          </a>
          <small>{item.license}</small>
        </div>
      </article>
    ))}
  </div>
)}
