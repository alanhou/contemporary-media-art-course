---
type Props = {
  kind?: "timeline" | "medium-map" | "matrix" | "ai-levels" | "viewer-spectrum";
  lang: "en" | "zh";
};

const { kind = "timeline", lang } = Astro.props;

const labels = {
  timeline: lang === "en"
    ? ["Orientation", "Artists", "Time", "Systems", "Themes", "Institutions", "Database", "Interpretation", "Taste", "Application", "Writing", "AI"]
    : ["导览", "艺术家", "时间", "系统", "主题", "机构", "数据库", "解读", "品味", "应用", "写作", "AI"],
  media: lang === "en"
    ? ["Idea", "Space", "Body", "Video", "Network", "AI"]
    : ["观念", "空间", "身体", "影像", "网络", "AI"],
  viewer: lang === "en"
    ? ["Observer", "Witness", "Participant", "Performer", "Data source", "Co-creator"]
    : ["观看者", "见证者", "参与者", "表演者", "数据源", "共创者"],
  ai: lang === "en"
    ? ["Tool", "Style machine", "Medium", "Collaborator", "Critique"]
    : ["工具", "风格机器", "媒介", "合作者", "批判"]
};
---

{kind === "timeline" && (
  <section class="visual-map visual-map--timeline" aria-label={lang === "en" ? "12-week timeline" : "12 周时间线"}>
    <div class="timeline-map">
      {labels.timeline.map((label, index) => (
        <div class="timeline-node">
          <span>{index + 1}</span>
          <strong>{label}</strong>
        </div>
      ))}
    </div>
  </section>
)}

{kind === "medium-map" && (
  <section class="visual-map radial-map" aria-label={lang === "en" ? "Medium map" : "媒介地图"}>
    <div class="radial-core">{lang === "en" ? "Contemporary Art" : "当代艺术"}</div>
    <div class="radial-grid">
      {labels.media.map((label) => (
        <div class="radial-item">
          <span>{label}</span>
        </div>
      ))}
    </div>
  </section>
)}

{kind === "matrix" && (
  <section class="visual-map" aria-label={lang === "en" ? "Artist theme matrix" : "艺术家主题矩阵"}>
    <div class="matrix-map">
      {(lang === "en"
        ? [["Politics", "Ai Weiwei"], ["Identity", "Sherman"], ["Video", "Paik"], ["Immersion", "Eliasson"], ["AI/Data", "Anadol"], ["Critique", "Steyerl"]]
        : [["政治", "艾未未"], ["身份", "Sherman"], ["影像", "白南准"], ["沉浸", "Eliasson"], ["AI/数据", "Anadol"], ["批判", "Steyerl"]]
      ).map(([theme, artist]) => (
        <div>
          <strong>{theme}</strong>
          <span>{artist}</span>
        </div>
      ))}
    </div>
  </section>
)}

{kind === "viewer-spectrum" && (
  <section class="visual-map" aria-label={lang === "en" ? "Viewer role spectrum" : "观看者角色光谱"}>
    <div class="spectrum-map">
      {labels.viewer.map((label) => <span>{label}</span>)}
    </div>
  </section>
)}

{kind === "ai-levels" && (
  <section class="visual-map" aria-label={lang === "en" ? "AI art levels" : "AI 艺术层级"}>
    <div class="ladder-map">
      {labels.ai.map((label, index) => (
        <div style={`--step:${index + 1}`}>
          <span>{index + 1}</span>
          <strong>{label}</strong>
        </div>
      ))}
    </div>
  </section>
)}
