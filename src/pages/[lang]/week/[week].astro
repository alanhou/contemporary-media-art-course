---
import MediaNotes from "@/components/MediaNotes.astro";
import MediaGallery from "@/components/MediaGallery.astro";
import Quiz from "@/components/Quiz.astro";
import VisualMap from "@/components/VisualMap.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getBeginnerGuide, getBeginnerQuizzes, getSupplementalMedia } from "@/data/beginnerGuides";
import { getLessonSections, getMediaItems, getWeek, getWeekQuizzes, navText, weeks, type Lang } from "@/data/course";
import { getArtistLessonCards, getFocusCards } from "@/data/lessonExplanations";

export function getStaticPaths() {
  return ["en", "zh"].flatMap((lang) =>
    weeks.map((week) => ({ params: { lang, week: String(week.week) } }))
  );
}

const lang = Astro.params.lang as Lang;
const weekNumber = Number(Astro.params.week);
const week = getWeek(weekNumber);

if (!week) {
  throw new Error(`Missing week ${Astro.params.week}`);
}

const t = navText[lang];
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const quizzes = [...getWeekQuizzes(week.week, lang), ...getBeginnerQuizzes(week.week, lang)];
const lessonSections = getLessonSections(week.week);
const beginnerGuide = getBeginnerGuide(week.week);
const mediaItems = [...getMediaItems(week.week), ...getSupplementalMedia(week.week)];
const focusCards = getFocusCards(week.week, week.focus[lang], lang);
const artistCards = getArtistLessonCards(week.artists, lang);
const previousWeek = getWeek(week.week - 1);
const nextWeek = getWeek(week.week + 1);
---

<BaseLayout
  title={`${week.title[lang]} | Contemporary Media Art Course`}
  description={week.goal[lang]}
  lang={lang}
  path={`/${lang}/week/${week.week}/`}
>
  <article class="lesson">
    <aside class="lesson-sidebar">
      <a href={`${base}/${lang}/`}>{t.course}</a>
      {weeks.map((item) => (
        <a class={item.week === week.week ? "is-active" : ""} href={`${base}/${lang}/week/${item.week}/`}>
          {item.week}. {item.title[lang]}
        </a>
      ))}
    </aside>

    <div class="lesson-body">
      <header class="lesson-header">
        <p class="eyebrow">Week {week.week}</p>
        <h1>{week.title[lang]}</h1>
        <p>{week.shift[lang]}</p>
      </header>

      <section class="lesson-section">
        <p class="eyebrow">{t.goal}</p>
        <h2>{week.goal[lang]}</h2>
      </section>

      {lessonSections.length > 0 && (
        <section class="lesson-section lesson-reading">
          <p class="eyebrow">{lang === "en" ? "Reading Notes" : "阅读笔记"}</p>
          {lessonSections.map((section) => (
            <article class="reading-block">
              <h2>{section.title[lang]}</h2>
              <p>{section.body[lang]}</p>
            </article>
          ))}
        </section>
      )}

      {beginnerGuide && (
        <section class="lesson-section beginner-guide">
          <p class="eyebrow">{lang === "en" ? "Beginner Path" : "初学者路径"}</p>
          <article class="guide-panel guide-key">
            <h2>{lang === "en" ? "Key idea in plain language" : "用白话说核心观念"}</h2>
            <p>{beginnerGuide.keyIdea[lang]}</p>
          </article>
          <div class="guide-grid">
            <article class="guide-panel">
              <h3>{lang === "en" ? "Glossary" : "词汇表"}</h3>
              <dl class="glossary-list">
                {beginnerGuide.glossary.map((entry) => (
                  <>
                    <dt>{entry.term[lang]}</dt>
                    <dd>{entry.definition[lang]}</dd>
                  </>
                ))}
              </dl>
            </article>
            <article class="guide-panel">
              <h3>{lang === "en" ? "Artwork walkthrough" : "作品走读"}</h3>
              <p class="guide-artwork">{beginnerGuide.walkthrough.artwork}</p>
              <ol>
                {beginnerGuide.walkthrough.steps[lang].map((step) => <li>{step}</li>)}
              </ol>
            </article>
            <article class="guide-panel">
              <h3>{lang === "en" ? "Common beginner mistake" : "初学者常见误区"}</h3>
              <p>{beginnerGuide.commonMistake[lang]}</p>
            </article>
            <article class="guide-panel">
              <h3>{lang === "en" ? "Try this now" : "现在试一下"}</h3>
              <p>{beginnerGuide.tryThis[lang]}</p>
            </article>
          </div>
        </section>
      )}

      <section class="lesson-section">
        <p class="eyebrow">{t.focus}</p>
        <div class="focus-card-grid">
          {focusCards.map((item) => (
            <article class="explain-card">
              <h3>{item.label}</h3>
              <p>{item.explanation}</p>
            </article>
          ))}
        </div>
      </section>

      {week.chart && (
        <section class="lesson-section">
          <p class="eyebrow">{t.chart}</p>
          <VisualMap kind={week.chart} lang={lang} />
        </section>
      )}

      <section class="lesson-section">
        <p class="eyebrow">{t.artists}</p>
        <div class="artist-lesson-grid">
          {artistCards.map((artist) => (
            <article class="explain-card artist-method-card">
              <h3>{artist.name}</h3>
              <p>{artist.method}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="lesson-section assignment">
        <p class="eyebrow">{t.assignment}</p>
        <p>{week.assignment[lang]}</p>
      </section>

      {quizzes.length > 0 && (
        <section class="lesson-section">
          <p class="eyebrow">{t.quiz}</p>
          {quizzes.map((quiz) => <Quiz quiz={quiz} />)}
        </section>
      )}

      <section class="lesson-section">
        <p class="eyebrow">{t.media}</p>
        <MediaGallery items={mediaItems} lang={lang} />
        <MediaNotes lang={lang} />
      </section>

      <nav class="pager" aria-label="Lesson">
        {previousWeek ? <a href={`${base}/${lang}/week/${previousWeek.week}/`}>{t.previous}: {previousWeek.title[lang]}</a> : <span />}
        {nextWeek ? <a href={`${base}/${lang}/week/${nextWeek.week}/`}>{t.next}: {nextWeek.title[lang]}</a> : <span />}
      </nav>
    </div>
  </article>
</BaseLayout>
