---
import BaseLayout from "@/layouts/BaseLayout.astro";
import VisualMap from "@/components/VisualMap.astro";
import { navText, type Lang } from "@/data/course";

export function getStaticPaths() {
  return ["en", "zh"].map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = navText[lang];
const cards = lang === "en"
  ? [
      ["Kosuth method", "Vocabulary appears as object, image, word, pinyin, and definition."],
      ["LeWitt method", "Grammar becomes a rule system that generates visual variation."],
      ["Holzer method", "Useful phrases appear as public LED language and urban signs."],
      ["Shiota method", "Words connect through radicals, tones, meaning, and memory."],
      ["Lozano-Hemmer method", "The learner's voice changes light, color, curves, and feedback."]
    ]
  : [
      ["Kosuth 方法", "词汇同时成为物体、图像、汉字、拼音和定义。"],
      ["LeWitt 方法", "语法成为能生成视觉变化的规则系统。"],
      ["Holzer 方法", "常用句子变成公共 LED 文字和城市标识。"],
      ["Shiota 方法", "词语通过部首、声调、意义和记忆连接成网络。"],
      ["Lozano-Hemmer 方法", "学习者的声音改变光、颜色、曲线和反馈。"]
    ];
---

<BaseLayout
  title={`${t.lab} | Contemporary Media Art Course`}
  description="MandarinAi method transfer lab."
  lang={lang}
  path={`/${lang}/mandarinai-lab/`}
>
  <section class="page-title">
    <p class="eyebrow">{t.lab}</p>
    <h1>{lang === "en" ? "Turn art methods into language-learning systems" : "把艺术方法转化为语言学习系统"}</h1>
    <p>
      {lang === "en"
        ? "This lab translates contemporary art methods into product concepts for Mandarin learning."
        : "这个实验室把当代艺术方法翻译成中文学习的产品概念。"}
    </p>
  </section>

  <section class="lesson-section">
    <VisualMap kind="ai-levels" lang={lang} />
  </section>

  <section class="method-grid">
    {cards.map(([title, body]) => (
      <article>
        <h2>{title}</h2>
        <p>{body}</p>
      </article>
    ))}
  </section>
</BaseLayout>
